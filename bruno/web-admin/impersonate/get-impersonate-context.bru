meta {
  name: Impersonate - Get User Context
  type: http
  seq: 2
}

get {
  url: {{base_url}}/web-admin/impersonate/{{user_id}}/context
  body: none
  auth: none
}

docs {
  Fetches the impersonated user's profile + resolved Cognito role
  (OrgAdmin | Manager | Employee). Used by the frontend to start an
  impersonation session before issuing any proxied requests.
}

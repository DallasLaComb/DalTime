meta {
  name: List Available Shifts (by Date)
  type: http
  seq: 1
}

get {
  url: {{base_url}}/employee/available-shifts?date=2025-06-15
  body: none
  auth: bearer
}

auth:bearer {
  token: {{employee_token}}
}

docs {
  Returns published shifts from OTHER employees in the caller's org that have been
  marked available_for_pickup=true for the given date. Used by employees to find
  shifts they can pick up.

  The caller's own shifts are always excluded (employee_id <> callerId).
  Returns 200 [] when no shifts are available — never 404.

  Query param: date=YYYY-MM-DD (required)

  Response 200:
  [
    {
      "shift_id": "xyz-999",
      "org_id": "org-sunset",
      "manager_id": "mgr-001",
      "employee_id": "emp-other",
      "employee_name": "Jane Doe",
      "location_id": "loc-1",
      "location_name": "Main Floor",
      "date": "2025-06-15",
      "start_time": "09:00",
      "end_time": "17:00",
      "type": "morning",
      "status": "published",
      "available_for_pickup": true,
      "created_at": "2025-06-01T00:00:00.000Z",
      "updated_at": "2025-06-14T10:00:00.000Z"
    }
  ]

  Response 400 (missing or invalid date):
  { "error": "\"date\" query param is required (YYYY-MM-DD)" }

  Response 403 (wrong role or not provisioned):
  { "error": "Employee role required" }

  Response 500 (unexpected server error):
  { "error": "An unexpected error occurred" }
}

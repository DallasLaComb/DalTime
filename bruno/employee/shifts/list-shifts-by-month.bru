meta {
  name: List Employee Shifts (Month)
  type: http
  seq: 1
}

get {
  url: {{base_url}}/employee/shifts?month=2025-06
  body: none
  auth: bearer
}

auth:bearer {
  token: {{employee_token}}
}

docs {
  Returns all published shifts assigned to the calling employee for the given calendar month.

  Query param: month=YYYY-MM (required — exactly one of month/date/week must be supplied)

  Response 200:
  [
    {
      "shift_id": "abc-123",
      "org_id": "org-sunset",
      "manager_id": "mgr-001",
      "employee_id": "emp-001",
      "employee_name": "Sam Smith",
      "location_id": "loc-1",
      "location_name": "Main Floor",
      "date": "2025-06-15",
      "start_time": "09:00",
      "end_time": "17:00",
      "type": "morning",
      "status": "published",
      "available_for_pickup": false,
      "created_at": "2025-06-01T00:00:00.000Z",
      "updated_at": "2025-06-01T00:00:00.000Z"
    }
  ]

  Response 400 (no param / multiple params / bad format):
  { "error": "One of \"month\" (YYYY-MM), \"date\" (YYYY-MM-DD), or \"week\" (YYYY-MM-DD) query params is required" }

  Response 403 (wrong role or not provisioned):
  { "error": "Employee role required" }
}

meta {
  name: List Employee Shifts (Day)
  type: http
  seq: 2
}

get {
  url: {{base_url}}/employee/shifts?date=2025-06-15
  body: none
  auth: bearer
}

auth:bearer {
  token: {{employee_token}}
}

docs {
  Returns all published shifts assigned to the calling employee on a specific date.

  Query param: date=YYYY-MM-DD (required — exactly one of month/date/week must be supplied)

  Response 200:
  [
    {
      "shift_id": "abc-123",
      "org_id": "org-sunset",
      "employee_id": "emp-001",
      "date": "2025-06-15",
      "start_time": "09:00",
      "end_time": "17:00",
      "type": "morning",
      "status": "published",
      "available_for_pickup": false,
      "created_at": "2025-06-01T00:00:00.000Z",
      "updated_at": "2025-06-01T00:00:00.000Z"
    }
  ]

  Response 400 (bad format):
  { "error": "date must be in YYYY-MM-DD format" }
}
